     with no receiver attached. Same code path as ZMQ from add() onward, so what you see is what a
@@ -324,7 +381,7 @@ def main():
 
     logtail = None
     if args.log:
-        logtail = LogTail(args.log)
+        logtail = DecoderLogTail(args.log)
