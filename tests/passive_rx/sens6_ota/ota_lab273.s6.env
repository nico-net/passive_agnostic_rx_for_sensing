# sens6 OTA environment for run_ota_s6.sh (sourced; KEY=VALUE lines only, no commands).
# Merged-main defaults are BAKED for --passive-rx in nr-uesoftmodem.c (log async, CSI-RS discovery, GPU budget,
# reconfiguration, USRP ring zero-copy, RX recover, start timeout, no TX) and the core plan exports every core key,
# so this file deliberately sets almost nothing. Do not add core numbers (ISAC_UE_RT_CORE, ISAC_UHD_CTRL_CORES,
# ISAC_FLOAT_CORES, ...): they override the plan. Do not add DGX-only keys (DPDK lcores, 34B2AF1 FO seeds).
#
# NEVER set ISAC_RX_BRANCH_FO (project hard rule: never enabled at rank > 1); the launcher refuses to start if it is set.
#
# Radio-side seeds (operator-entered tuning, not discovered; override on the launcher command line):
CARRIER=3450000000      # lab cell centre (dl_arfcn 630000); for a commercial cell use the blind front end values
PRB=273                 # 100 MHz at 30 kHz -> 122.88 MS/s per channel (UC_200 image: MCR 245.76 MHz, DDC /2)
SSB=150                 # SSB subcarrier of the lab cell as observed on air 2026-09-25 (sens6, unit 327C1F2); SCAN=1 searches instead
NANT=4                  # 4 RX (operator rule: 4 RX for all tests)
RXG=49                  # lab 273 PRB value of 2026-09-14/25 (unit 327C1F2); unit 327B872 gain not measured on this cell
INITIALFO=-15000        # lab gNB offset seed (measured -13.1/-13.4 kHz on 2026-09-25 with unit 327C1F2) [HYPOTHESIS: gNB-dominated, holds for 327B872]
DUR=300                 # seconds per run (SIGINT at the end)
