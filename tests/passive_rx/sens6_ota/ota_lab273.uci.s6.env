# sens6 OTA environment for run_ota_s6.sh (sourced; KEY=VALUE lines only, no commands).
# Merged-main defaults are BAKED for --passive-rx in nr-uesoftmodem.c (log async, CSI-RS discovery, GPU budget,
# reconfiguration, USRP ring zero-copy, RX recover, start timeout, no TX) and the core plan exports every core key,
# so this file deliberately sets almost nothing. Do not add core numbers (ISAC_UE_RT_CORE, ISAC_UHD_CTRL_CORES,
# ISAC_FLOAT_CORES, ...): they override the plan. Do not add DGX-only keys (DPDK lcores, 34B2AF1 FO seeds).
#
# NEVER set ISAC_RX_BRANCH_FO (project hard rule: never enabled at rank > 1); the launcher refuses to start if it is set.
#
# Radio-side seeds (operator-entered tuning, not discovered; override on the launcher command line):
CARRIER=3450000000      # lab cell centre (dl_arfcn 630000); for a commercial cell use the blind front end values
PRB=273                 # 100 MHz at 30 kHz -> 122.88 MS/s per channel (UC_200 image: MCR 245.76 MHz, DDC /2)
SSB=150                 # SSB subcarrier of the lab cell as observed on air 2026-09-25 (sens6, unit 327C1F2); SCAN=1 searches instead
NANT=4                  # 4 RX (operator rule: 4 RX for all tests)
RXG=49                  # lab 273 PRB value of 2026-09-14/25 (unit 327C1F2); unit 327B872 gain not measured on this cell
INITIALFO=-15000        # lab gNB offset seed (measured -13.1/-13.4 kHz on 2026-09-25 with unit 327C1F2) [HYPOTHESIS: gNB-dominated, holds for 327B872]
DUR=300                 # seconds per run (SIGINT at the end)
#
# Receiver environment (passed through `sudo -n env` by run_ota_s6.sh; sudo resets the environment, so only RXENV reaches it):
#   GPU paths: default auto (no NR_GPU_PATH_* override). Since the sens6/dgpu-q4 merge the per-path trials choose GPU or CPU per
#                           path on this host (Q4-DISCRETE-273-20261024.md: DL chest/demod/GPUPASS on the GPU, UL on the CPU);
#                           the GPU_PATH lines of the run log record each choice.
#   ISAC_USRP_RING_MS=500  decoupled RX ring as on the DGX air runs (rr-orchestration starttest.sh); sized by the host-RAM budget
#                          (reserved first, floor 100 ms, else HOST_MEM REFUSE exit 7); ring core from the core plan (isolated CPU 2)
RXENV="ISAC_USRP_RING_MS=500"
#
# X410 device arguments (X410 link report 2026-10-24: unit 327B872 / board 327488F, UC_200, MPM 6.1, FPGA 11.0, UHD 4.10.0;
# benchmark_rate 30 s RX-only 122.88 MS/s, 4 ch and 2 ch: 0 drops/overruns/seq errors) -> --usrp-args type=x4xx,addr=192.168.20.2,mgmt_addr=192.168.20.2
#   DATA     data address (discovery 2026-10-24 18:57: serial 327B872, fpga UC_200, mgmt_addr 192.168.20.2, claimed False)
#   MGMT     empty = what uhd_find_devices reports (today the data address; 128.178.122.174 and 192.168.1.140 do not answer)
#   USRPX    extra --usrp-args (",key=value,..."), e.g. a master_clock_rate or recv_buff_size from that report. Empty = the driver's
#            choice: UC_200 has a DDC -> master_clock_rate 245.76e6, 122.88 MS/s by FPGA decimation /2, no software decimation
#            (radio/USRP/usrp_lib.cpp, [CODE-READ]); a CG image would select 491.52e6 + software decimation by itself.
DATA=192.168.20.2
MGMT=192.168.20.2
USRPX=
CFG=$H/ue.passive.ota.lab273.uci.s6.cfg   # A/B: UCI-on-PUSCH recovery on
